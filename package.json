{
  "name": "make-anything",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm --filter ./web dev",
    "build": "pnpm --filter ./web build",
    "lint": "pnpm --filter ./web lint",
    "typecheck": "pnpm --filter ./web typecheck",
    "test": "pnpm --filter ./web test",
    "test:db": "node scripts/db-smoke-test.mjs",
    "test:e2e": "pnpm --filter ./web test:e2e",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm i18n:check && pnpm check:repo"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.32",
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
