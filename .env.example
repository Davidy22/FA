# Local OAuth credentials read by supabase/config.toml via env(...).
# Copy this file to .env (which is git-ignored) and fill in values from the
# Google Cloud Console / Meta for Developers / GitHub Developer Settings.
# Callback URL registered with each provider:
#   http://localhost:54321/auth/v1/callback
# For the hosted project use https://<project-ref>.supabase.co/auth/v1/callback.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
